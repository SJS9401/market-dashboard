  "key_findings": {
    "_note": "★ 이 데이터로 새로 확인된 것 — 대시보드 서술의 근거.",
    "1_lead_lag": {
      "title": "주가는 이익보다 먼저 꺾였다 — 다만 선행 폭이 사이클마다 다르다",
      "detail": [
        "조선 시총 정점 2007-10 → 분기 OPM 정점 2010-1Q → 실제 이익 붕괴 2012~2013",
        "주가가 OPM 정점보다 약 2년 선행, 적자 전환까지는 5년",
        "시스코는 주가 정점(2000-03)과 이익 정점(FY2000)이 동시, 적자는 1년 뒤(FY2001)"
      ],
      "implication": "선행 폭을 가른 것은 수주잔고다. 조선은 3년치 잔고가 실적을 떠받쳐 붕괴가 늦었다. → 하이닉스 LTA 는 5년(CAPA 60~70%)이므로 조선보다 길다. 주가 정점 후 실적이 버티는 기간이 더 길 수 있다는 뜻이며, 동시에 '실적이 좋다'가 주가 바닥의 근거가 되지 못한다는 뜻이기도 하다."
    },
    "2_advances": {
      "title": "선수금 = LTA 예치금. 잔액이 아니라 증감 방향이 신호",
      "detail": ["미포 선수금 2008 2,668 → 2012 1,834 (-31.3%), 정점 이후 4년 연속 감소"],
      "implication": "⑦에서 '예치금이 물량 리스크를 막는다'고 결론냈으나, 조선 사례는 예치금 자체가 줄어드는 것이 진짜 신호였음을 보여준다. → SK하이닉스·삼성전자 분기 재무제표의 선수금 계정을 추적 지표로 추가."
    },
    "3_consensus": {
      "title": "정점 컨센서스는 -79% 틀렸다",
      "detail": ["2011-01 삼성증권 2012E 영업이익 442 → 실제 93 (-78.9%), 이듬해 적자"],
      "implication": "시스코 FY2001(컨센 40~50% 성장 → 실제 -2,004 적자)과 같은 패턴. 하이닉스 2027E 77.6% 마진 컨센을 그대로 믿을 근거가 약해진다."
    },
    "4_price_momentum": {
      "title": "선가도 레벨이 아니라 모멘텀이 먼저 꺾였다",
      "detail": ["Clarkson 지수는 2005 중반 170 도달 후 2007까지 162~168 횡보", "MoM 은 2005 상반기 +4~4.5% 피크 후 하반기 마이너스 전환"],
      "implication": "DRAM ASP 와 동형. 절대 가격은 사상 최고인데 상승률이 감속하는 국면이 주가 정점과 겹친다. 조선은 선가 모멘텀 꺾임(2005 하반기) → 시총 정점(2007-10)까지 약 2년 시차."
    }
  }
